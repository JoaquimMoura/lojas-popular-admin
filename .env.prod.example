# Copie para ".env" na VPS (ao lado do docker-compose.prod.yml) e preencha.
# Nunca commitar o ".env" real no git.

# --- Postgres ---
POSTGRES_DB=lojas_popular
POSTGRES_USER=lojas_popular
POSTGRES_PASSWORD=

# --- JWT (obrigatório: gere uma string aleatória de 64+ caracteres) ---
JWT_SECRET=

# --- RabbitMQ ---
# Decidido deixar de fora por enquanto (notificação WhatsApp fica desativada).
# A aplicação PRECISA que essas variáveis existam para iniciar, mas não precisa
# que o RabbitMQ esteja de pé — sem servidor, ela só loga o erro e segue rodando.
# Pode manter estes valores fixos abaixo até adicionar RabbitMQ de fato.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- WhatsApp (Zenvia) ---
# Obrigatório existir para a aplicação iniciar. Sem integração real ainda,
# pode deixar qualquer valor placeholder.
WHATSAPP_API_KEY=nao-configurado

# --- Mercado Pago ---
# Mesma observação: obrigatório existir, preencha com o token real quando
# for habilitar pagamentos online.
MP_ACCESS_TOKEN=nao-configurado
MP_WEBHOOK_SECRET=nao-configurado
